// Windows resources of glimpse.exe: the icon Explorer and the taskbar show,
// and the version details of the file's properties. Configured by CMake.
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/glimpse.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Glimpse"
            VALUE "FileDescription", "Glimpse"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "glimpse"
            VALUE "LegalCopyright", "Copyright (c) 2026 Kaguya. MIT License."
            VALUE "OriginalFilename", "glimpse.exe"
            VALUE "ProductName", "Glimpse"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
