<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SettingsDialog</class>
 <widget class="QDialog" name="SettingsDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>460</width>
    <height>260</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Glimpse Settings</string>
  </property>
  <layout class="QVBoxLayout" name="dialogLayout">
   <item>
    <widget class="QTabWidget" name="tabs">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <widget class="QWidget" name="generalTab">
      <attribute name="title">
       <string>General</string>
      </attribute>
      <layout class="QVBoxLayout" name="generalLayout">
       <item>
        <layout class="QFormLayout" name="generalForm">
         <item row="0" column="0">
          <widget class="QLabel" name="languageLabel">
           <property name="text">
            <string>&amp;Language:</string>
           </property>
           <property name="buddy">
            <cstring>languageCombo</cstring>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QComboBox" name="languageCombo"/>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QGroupBox" name="captureGroup">
         <property name="title">
          <string>Captures</string>
         </property>
         <layout class="QVBoxLayout" name="captureLayout">
          <item>
           <widget class="QCheckBox" name="captureToolbarCheck">
            <property name="text">
             <string>Include the Glimpse &amp;toolbar</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="captureCursorCheck">
            <property name="text">
             <string>Include the &amp;mouse pointer</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="generalSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="hotkeysTab">
      <attribute name="title">
       <string>Hotkeys</string>
      </attribute>
      <layout class="QVBoxLayout" name="hotkeysLayout">
       <item>
        <layout class="QFormLayout" name="hotkeysForm">
         <item row="0" column="0">
          <widget class="QLabel" name="windowHotkeyLabel">
           <property name="text">
            <string>Capture &amp;Window / Object:</string>
           </property>
           <property name="buddy">
            <cstring>windowHotkeyEdit</cstring>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="HotkeyEdit" name="windowHotkeyEdit"/>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="regionHotkeyLabel">
           <property name="text">
            <string>Capture &amp;Rectangular Region:</string>
           </property>
           <property name="buddy">
            <cstring>regionHotkeyEdit</cstring>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="HotkeyEdit" name="regionHotkeyEdit"/>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="freehandHotkeyLabel">
           <property name="text">
            <string>Capture Free&amp;hand Region:</string>
           </property>
           <property name="buddy">
            <cstring>freehandHotkeyEdit</cstring>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="HotkeyEdit" name="freehandHotkeyEdit"/>
         </item>
         <item row="3" column="0">
          <widget class="QLabel" name="fullScreenHotkeyLabel">
           <property name="text">
            <string>Capture &amp;Full Screen:</string>
           </property>
           <property name="buddy">
            <cstring>fullScreenHotkeyEdit</cstring>
           </property>
          </widget>
         </item>
         <item row="3" column="1">
          <widget class="HotkeyEdit" name="fullScreenHotkeyEdit"/>
         </item>
         <item row="4" column="0">
          <widget class="QLabel" name="qrHotkeyLabel">
           <property name="text">
            <string>Scan &amp;QR Code:</string>
           </property>
           <property name="buddy">
            <cstring>qrHotkeyEdit</cstring>
           </property>
          </widget>
         </item>
         <item row="4" column="1">
          <widget class="HotkeyEdit" name="qrHotkeyEdit"/>
         </item>
         <item row="5" column="0">
          <widget class="QLabel" name="ocrHotkeyLabel">
           <property name="text">
            <string>Recognize &amp;Text:</string>
           </property>
           <property name="buddy">
            <cstring>ocrHotkeyEdit</cstring>
           </property>
          </widget>
         </item>
         <item row="5" column="1">
          <widget class="HotkeyEdit" name="ocrHotkeyEdit"/>
         </item>
         <item row="6" column="0">
          <widget class="QLabel" name="scrollHotkeyLabel">
           <property name="text">
            <string>&amp;Scrolling Capture:</string>
           </property>
           <property name="buddy">
            <cstring>scrollHotkeyEdit</cstring>
           </property>
          </widget>
         </item>
         <item row="6" column="1">
          <widget class="HotkeyEdit" name="scrollHotkeyEdit"/>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="hotkeysHint">
         <property name="text">
          <string>Click a field and press the new key combination. Clear a field to disable that hotkey. Hotkeys are paused while this window is open.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="foregroundRole">
          <enum>QPalette::PlaceholderText</enum>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="hotkeysSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="ocrTab">
      <attribute name="title">
       <string>Text Recognition</string>
      </attribute>
      <layout class="QVBoxLayout" name="ocrLayout">
       <item>
        <layout class="QFormLayout" name="ocrForm">
         <item row="0" column="0">
          <widget class="QLabel" name="ocrEngineLabel">
           <property name="text">
            <string>&amp;Engine:</string>
           </property>
           <property name="buddy">
            <cstring>ocrEngineCombo</cstring>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QComboBox" name="ocrEngineCombo"/>
         </item>
         <item row="1" column="1">
          <widget class="QLabel" name="ocrEngineNote">
           <property name="wordWrap">
            <bool>true</bool>
           </property>
           <property name="foregroundRole">
            <enum>QPalette::PlaceholderText</enum>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="ocrLanguagesLabel">
           <property name="text">
            <string>Languages:</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <layout class="QHBoxLayout" name="ocrLanguagesLayout">
           <item>
            <widget class="QCheckBox" name="ocrChineseCheck">
             <property name="text">
              <string>&amp;Chinese (Simplified)</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="ocrJapaneseCheck">
             <property name="text">
              <string>&amp;Japanese</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="ocrEnglishCheck">
             <property name="text">
              <string>E&amp;nglish</string>
             </property>
            </widget>
           </item>
           <item>
            <spacer name="ocrLanguagesSpacer">
             <property name="orientation">
              <enum>Qt::Horizontal</enum>
             </property>
            </spacer>
           </item>
          </layout>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="ocrHint">
         <property name="text">
          <string>Recognition models are downloaded the first time they are needed. Selecting fewer languages makes recognition faster and more accurate.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="foregroundRole">
          <enum>QPalette::PlaceholderText</enum>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="ocrSpacer">
